        </mxCell>
        <mxCell id="wafrules" value="WebACL 规则（优先级从高到低）&#10;P5&amp;nbsp;&amp;nbsp; Geo 白名单（可选开关）&#10;P10-12 AWS 托管组：Common* / KnownBadInputs / IpReputation&#10;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;*SizeRestrictions/GenericLFI/XSS_BODY 已 override=Count（防误伤 Claude Code 大 body/路径/代码）&#10;P20&amp;nbsp; 管理路径锁定 /key /config /ui /spend…（开关，待客户运维出口 IP）&#10;P30/31 按 API-key 限速 3000/5min（Authorization + x-api-key 头聚合，防单 key 被刷）&#10;P32&amp;nbsp; 按 IP 限速 20000/5min（DoS 兜底，2000 人共享出口 NAT 不能按 IP 主限）" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#DD344C;align=left;verticalAlign=top;fontSize=11;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="870" y="85" width="500" height="170" as="geometry" />
        </mxCell>
        <mxCell id="waflogs" value="CloudWatch Logs&#10;aws-waf-logs-*（脱敏 key 头）" style="sketch=0;points=[[0,0,0],[0.25,0,0],[0.5,0,0],[0.75,0,0],[1,0,0],[0,1,0],[0.25,1,0],[0.5,1,0],[0.75,1,0],[1,1,0],[0,0.25,0],[0,0.5,0],[0,0.75,0],[1,0.25,0],[1,0.5,0],[1,0.75,0]];outlineConnect=0;fontColor=#232F3E;fillColor=#E7157B;strokeColor=#ffffff;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1">
