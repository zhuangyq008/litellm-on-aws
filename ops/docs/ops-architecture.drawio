<mxfile host="app.diagrams.net" agent="claude-code" version="24.7.7">
  <diagram id="ops-arch" name="LiteLLM-GW Ops 架构">
    <mxGraphModel dx="1600" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1700" pageHeight="1450" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ======== 标题 ======== -->
        <mxCell id="title" value="LiteLLM Gateway — Ops 运维加固模块架构（5 个独立栈：monitoring / waf / security / flowlogs / cost，与主栈解耦、只读引用导出）" style="text;html=1;align=left;verticalAlign=middle;fontSize=18;fontStyle=1;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="30" y="4" width="1400" height="30" as="geometry" />
        </mxCell>

        <!-- ======== 分层背景带 ======== -->
        <mxCell id="band1" value="① 接入与边缘防护层 — Global Accelerator + WAF（litellm-gw-ops-waf）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=14;fontStyle=1;spacingLeft=12;spacingTop=4;fillColor=#FCF2E8;strokeColor=#D79B00;fontColor=#8F5B00;" vertex="1" parent="1">
          <mxGeometry x="20" y="40" width="1660" height="245" as="geometry" />
        </mxCell>
        <mxCell id="band2" value="② 网关本体层 — 主栈上下文（Ops 模块只读引用 ALBArn/ECSCluster/Service 导出，不修改主栈资源）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=14;fontStyle=1;spacingLeft=12;spacingTop=4;fillColor=#F5F5F5;strokeColor=#999999;fontColor=#555555;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="20" y="300" width="1660" height="275" as="geometry" />
        </mxCell>
        <mxCell id="band3" value="③ 监控·告警·通知层（litellm-gw-ops-monitoring + master key 使用绊线）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=14;fontStyle=1;spacingLeft=12;spacingTop=4;fillColor=#FCE8F1;strokeColor=#E7157B;fontColor=#9C0F52;" vertex="1" parent="1">
          <mxGeometry x="20" y="590" width="1660" height="285" as="geometry" />
        </mxCell>
        <mxCell id="band4" value="④ 安全事件与取证层（litellm-gw-ops-security / litellm-gw-ops-flowlogs + CloudTrail·Athena 溯源）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=14;fontStyle=1;spacingLeft=12;spacingTop=4;fillColor=#FBEAEC;strokeColor=#DD344C;fontColor=#96222F;" vertex="1" parent="1">
          <mxGeometry x="20" y="890" width="1660" height="305" as="geometry" />
        </mxCell>
        <mxCell id="band5" value="⑤ 成本治理层（litellm-gw-ops-cost）" style="rounded=1;whiteSpace=wrap;html=1;verticalAlign=top;align=left;fontSize=14;fontStyle=1;spacingLeft=12;spacingTop=4;fillColor=#EFF5E5;strokeColor=#7AA116;fontColor=#4A6510;" vertex="1" parent="1">
          <mxGeometry x="20" y="1210" width="1660" height="180" as="geometry" />
        </mxCell>

