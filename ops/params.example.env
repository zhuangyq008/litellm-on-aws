# LiteLLM Gateway - Ops 模块参数模板
# 复制为 params.env 后填写（params.env 已被 .gitignore 忽略，勿提交）
#   cp ops/params.example.env ops/params.env

# ---------- IM 通知 ----------
# 群机器人类型：feishu | dingtalk | wecom
IM_TYPE="feishu"
# 群机器人 webhook URL（敏感）
WEBHOOK_URL="https://open.feishu.cn/open-apis/bot/v2/hook/xxxxxxxx"
# 加签密钥（可选：飞书/钉钉支持；企业微信留空）
WEBHOOK_SIGN_SECRET=""

# ---------- WAF ----------
# 管理路径 IP 白名单开关（限制 master key 管理操作）。false 时不创建 IPSet 与锁定规则。
ENABLE_ADMIN_LOCKDOWN="false"
# 管理操作允许的源 IP（逗号分隔 CIDR）——仅 ENABLE_ADMIN_LOCKDOWN=true 时生效
ALLOWED_ADMIN_CIDRS="203.0.113.10/32,198.51.100.0/24"
# 单 IP 5 分钟请求上限，超出自动拦截（按客户正常峰值设定）
RATE_LIMIT="2000"
# 区域白名单开关与允许的国家码
ENABLE_GEO_BLOCK="false"
ALLOWED_COUNTRIES="CN"

# ---------- 可选 ----------
# 目标组全名 targetgroup/xxx/yyy（填了才创建 UnHealthyHost 告警）
# 取值：aws elbv2 describe-target-groups --names litellm-gw-tg \
#        --query 'TargetGroups[0].TargetGroupArn' --output text  的 arn 中 targetgroup/ 之后部分
TARGET_GROUP_FULL_NAME=""
